# OpenPAVE four-dimension validated recipe: Radxa O6 (Armv9) brain -> PuppyPi body over the seam plugin.
#
# A config is a *validated combination* of the four OpenPAVE dimensions (see
# docs/openpave-platform-spec.md and docs/validation-matrix.md). Adapters/backends are reusable
# parts; this file pins one reproducible recipe.
#
#   1. Brain-side node   : Radxa O6 (Armv9)                  -> BRAIN_HOST / BRAIN_PYTHON
#   2. Body endpoint     : PuppyPi + persistent bridge       -> ROBOT_ADAPTER=puppypi_bridge
#   3. Seam transport    : raw_zenoh | device_connect        -> SEAM_TRANSPORT   (swap this line)
#   4. Inference / app   : vLLM / OpenAI-compatible VLM       -> INFERENCE_RUNTIME / UI_*
#
# Validated 2026-09-02 (docs/validation-matrix.md, "Real-Brain Seam Plugin Validation"):
# first real-brain validation of Radxa O6 over BOTH transports, all path=bridge
# (raw_zenoh 512/1013/514 ms, device_connect 511/1014/514 ms for home/trot/stop).
#
# One-command run (from the repo root on each host), e.g.:
#   body  (on PuppyPi): scripts/seam_run.sh configs/radxa-puppypi.env body
#   brain (on Radxa)  : scripts/seam_run.sh configs/radxa-puppypi.env brain send home
# scripts/seam_run.sh sources this file and derives the transport wire env
# (raw_zenoh: ZENOH_LISTEN on the body / ZENOH_CONNECT=tcp/$BODY_HOST:7447 on the brain;
#  device_connect: DEVICE_CONNECT_ALLOW_INSECURE on both, D2D via zenoh multicast, no infra).

# --- dimension 1: brain-side node ---
BRAIN_HOST=192.168.0.5
BRAIN_PYTHON=$HOME/.venv/bin/python

# --- dimension 2: body endpoint ---
BODY_HOST=192.168.0.6
BODY_PYTHON=$HOME/.venv-dc/bin/python
ROBOT_ADAPTER=puppypi_bridge
PUPPY_BRIDGE_HOST=127.0.0.1

# --- dimension 3: seam transport (the swappable plugin dimension) ---
SEAM_TRANSPORT=raw_zenoh
SEAM_ZENOH_PORT=7447

# --- dimension 4: inference / upper-layer application ---
# Today this is the OpenAI-compatible VLM API used by the /pave baseline path; a registered
# create_inference_runtime(name) plugin surface is roadmap (INFERENCE_RUNTIME names the intent).
INFERENCE_RUNTIME=vllm_openai
UI_MODEL=llava-hf/llava-v1.6-mistral-7b-hf
UI_API_BASE=http://192.168.0.5:8000/v1
